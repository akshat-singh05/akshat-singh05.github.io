---
// CareChain: five contracts on a local Hardhat chain, records encrypted off-chain. Names match the repository.
const contracts = [
  { name: 'CareChainRegistry', sub: 'identities and roles', x: 36, y: 206, w: 150 },
  { name: 'ConsentManager', sub: 'ABAC consent', x: 196, y: 206, w: 150 },
  { name: 'RecordAnchor', sub: 'hashes, Merkle roots', x: 356, y: 206, w: 150 },
  { name: 'EmergencyAccess', sub: 'break-glass', x: 36, y: 300, w: 150 },
  { name: 'AuditLog', sub: 'append-only trail', x: 196, y: 300, w: 310 },
];
---
<svg viewBox="0 0 760 400" role="img" aria-labelledby="cc-title" xmlns="http://www.w3.org/2000/svg">
  <title id="cc-title">CareChain architecture</title>
  <defs>
    <marker id="cc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="dg-arrow" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <rect class="dg-box" x="20" y="30" width="150" height="60" rx="3" />
  <text class="dg-label" x="95" y="56" text-anchor="middle">Users</text>
  <text class="dg-sub" x="95" y="74" text-anchor="middle">five roles</text>

  <path class="dg-edge" d="M170 60 H218" marker-end="url(#cc-arrow)" />

  <rect class="dg-box" x="220" y="30" width="170" height="60" rx="3" />
  <text class="dg-label" x="305" y="56" text-anchor="middle">React front end</text>
  <text class="dg-sub" x="305" y="74" text-anchor="middle">Vite</text>

  <path class="dg-edge" d="M390 60 H438" marker-end="url(#cc-arrow)" />

  <rect class="dg-box" x="440" y="30" width="300" height="60" rx="3" />
  <text class="dg-label" x="590" y="56" text-anchor="middle">Express API</text>
  <text class="dg-sub" x="590" y="74" text-anchor="middle">JWT roles · AES-256-GCM · ethers.js</text>

  <path class="dg-edge" d="M500 90 V128 H271 V170" marker-end="url(#cc-arrow)" />
  <text class="dg-tag" x="282" y="150">contract calls</text>
  <path class="dg-edge" d="M650 90 V204" marker-end="url(#cc-arrow)" />
  <text class="dg-tag" x="642" y="150" text-anchor="end">encrypted records</text>

  <rect class="dg-group" x="20" y="172" width="502" height="200" rx="3" />
  <text class="dg-tag" x="32" y="192">smart contracts · local Hardhat chain</text>

  {contracts.map((c) => (
    <g>
      <rect class="dg-box dg-box--accent" x={c.x} y={c.y} width={c.w} height="56" rx="3" />
      <text class="dg-label" x={c.x + c.w / 2} y={c.y + 25} text-anchor="middle" style="font-size: 13px">{c.name}</text>
      <text class="dg-sub" x={c.x + c.w / 2} y={c.y + 43} text-anchor="middle">{c.sub}</text>
    </g>
  ))}
  <path class="dg-edge dg-edge--dashed" d="M271 262 V298" marker-end="url(#cc-arrow)" />
  <path class="dg-edge dg-edge--dashed" d="M186 328 H194" marker-end="url(#cc-arrow)" />

  <rect class="dg-box" x="560" y="206" width="180" height="150" rx="3" />
  <text class="dg-label" x="650" y="270" text-anchor="middle">Encrypted</text>
  <text class="dg-label" x="650" y="288" text-anchor="middle">blob store</text>
  <text class="dg-sub" x="650" y="308" text-anchor="middle">off-chain</text>

  <path class="dg-edge dg-edge--dashed" d="M506 234 H558" marker-end="url(#cc-arrow)" />
  <text class="dg-sub" x="528" y="226">hash</text>
</svg>
