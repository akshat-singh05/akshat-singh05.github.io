---
// CareChain: consent and access on a permissioned chain, records encrypted off-chain.
---
<svg viewBox="0 0 760 420" role="img" aria-labelledby="cc-title" xmlns="http://www.w3.org/2000/svg">
  <title id="cc-title">CareChain architecture</title>
  <defs>
    <marker id="cc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="dg-arrow" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <rect class="dg-box" x="20" y="30" width="150" height="60" rx="3" />
  <text class="dg-label" x="95" y="56" text-anchor="middle">Patient</text>
  <text class="dg-sub" x="95" y="74" text-anchor="middle">controls who reads</text>

  <path class="dg-edge" d="M170 60 H218" marker-end="url(#cc-arrow)" />

  <rect class="dg-box" x="220" y="30" width="180" height="60" rx="3" />
  <text class="dg-label" x="310" y="56" text-anchor="middle">React frontend</text>
  <text class="dg-sub" x="310" y="74" text-anchor="middle">web client</text>

  <path class="dg-edge" d="M400 60 H448" marker-end="url(#cc-arrow)" />

  <rect class="dg-box" x="450" y="30" width="290" height="60" rx="3" />
  <text class="dg-label" x="595" y="56" text-anchor="middle">Node.js + Express</text>
  <text class="dg-sub" x="595" y="74" text-anchor="middle">backend</text>

  <path class="dg-edge" d="M520 90 V130 H230 V198" marker-end="url(#cc-arrow)" />
  <text class="dg-tag" x="250" y="152">consent and access</text>
  <path class="dg-edge" d="M660 90 V198" marker-end="url(#cc-arrow)" />
  <text class="dg-tag" x="670" y="152">records</text>

  <rect class="dg-group" x="20" y="170" width="420" height="230" rx="3" />
  <text class="dg-tag" x="32" y="188">permissioned blockchain</text>

  <rect class="dg-box dg-box--accent" x="36" y="200" width="388" height="76" rx="3" />
  <text class="dg-label" x="230" y="230" text-anchor="middle">Smart contracts</text>
  <text class="dg-sub" x="230" y="250" text-anchor="middle">consent and access decisions</text>

  <rect class="dg-box dg-box--accent" x="36" y="300" width="388" height="76" rx="3" />
  <text class="dg-label" x="230" y="330" text-anchor="middle">Record hashes</text>
  <text class="dg-sub" x="230" y="350" text-anchor="middle">cryptographic hash per record</text>

  <rect class="dg-box" x="500" y="200" width="240" height="176" rx="3" />
  <text class="dg-label" x="620" y="280" text-anchor="middle">Encrypted off-chain</text>
  <text class="dg-label" x="620" y="298" text-anchor="middle">storage</text>
  <text class="dg-sub" x="620" y="318" text-anchor="middle">the records themselves</text>

  <path class="dg-edge dg-edge--dashed" d="M424 338 H498" marker-end="url(#cc-arrow)" />
  <text class="dg-sub" x="432" y="330">refers to</text>
</svg>
